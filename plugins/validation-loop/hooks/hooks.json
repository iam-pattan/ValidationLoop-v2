{
  "description": "ValidationLoop — captures each prompt's goal (UserPromptSubmit, for live-session anchoring + later alignment scoring), tracks file changes (PostToolUse), and runs a scored second-model validation ON DEMAND via the /validate slash command (not on every Stop).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/scripts/goal-capture.sh",
            "timeout": 10,
            "statusMessage": "Capturing goal for ValidationLoop"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/scripts/glm-qc-mark.sh",
            "statusMessage": "Tracking change for ValidationLoop"
          }
        ]
      }
    ]
  }
}
